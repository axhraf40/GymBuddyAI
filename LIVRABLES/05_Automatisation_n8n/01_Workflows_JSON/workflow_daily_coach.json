{
  "name": "GymBuddy AI - Daily Coaching Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * *"
            }
          ]
        }
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Daily 07:30 Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GYMBUDDY_API_URL }}/api/automation/daily-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.GYMBUDDY_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Fetch Opted-In Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Has Users?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "users",
        "options": {}
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Split Users",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_ENDPOINT || 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LLM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL || 'gemini-2.0-flash', temperature: 0.5, max_tokens: 350, messages: [ { role: 'system', content: 'You are GymBuddy, a concise and motivating AI gym & nutrition coach. Write a short morning coaching email (under 150 words) with: 1) Today\\'s workout focus, 2) Calorie, protein and water reminders, 3) One practical meal or recovery tip respecting the user\\'s diet, allergies and injuries.' }, { role: 'user', content: JSON.stringify($json) } ] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Generate AI Daily Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        220
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const user = $('Split Users').item.json;\nconst aiText = $json.choices?.[0]?.message?.content;\nconst fallback = `Hi ${user.name || 'athlete'},\\n\\nToday's plan: ${user.today_workout} (${user.equipment}).\\nTargets: ${user.calories} kcal · ${user.protein_g}g protein · ${user.water_l}L water.\\nStay consistent!`;\nconst body = (aiText || fallback).trim();\nreturn {\n  json: {\n    email: user.email,\n    name: user.name || 'Athlete',\n    subject: `GymBuddy Daily Plan: ${user.today_workout}`,\n    body_text: body,\n    used_ai: Boolean(aiText),\n    sent_at: new Date().toISOString()\n  }\n};"
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "Format Email & Fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        220
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body_text }}",
        "options": {}
      },
      "id": "1a2b3c4d-0007-4000-8000-000000000007",
      "name": "Send Coaching Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1540,
        220
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "GymBuddy SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{\n  json: {\n    status: 'completed',\n    emails_sent: items.length,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "1a2b3c4d-0008-4000-8000-000000000008",
      "name": "Log Execution Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        220
      ]
    }
  ],
  "connections": {
    "Daily 07:30 Trigger": {
      "main": [
        [
          {
            "node": "Fetch Opted-In Users",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Opted-In Users": {
      "main": [
        [
          {
            "node": "Has Users?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Users?": {
      "main": [
        [
          {
            "node": "Split Users",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split Users": {
      "main": [
        [
          {
            "node": "Generate AI Daily Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate AI Daily Message": {
      "main": [
        [
          {
            "node": "Format Email & Fallback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Email & Fallback": {
      "main": [
        [
          {
            "node": "Send Coaching Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Coaching Email": {
      "main": [
        [
          {
            "node": "Log Execution Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}