# Copy this file to .env and fill in the values.

# LLM provider: mock (no key needed, for tests/offline demo) | gemini | openrouter
LLM_PROVIDER=mock
# Model name for the chosen provider, e.g.
#   gemini      -> gemini-2.0-flash
#   openrouter  -> google/gemma-4-31b-it:free (or openrouter/free)
LLM_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Image Generation (Recraft V4.1 Flash V2 free via OpenRouter)
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=recraft/recraft-v4.1-flash-v2:free

# Email Verification & Password Reset Codes (Gmail SMTP)
# Email codes: set ONE of these (tried in this order). Brevo/Resend use HTTPS and work on Vercel; Gmail SMTP often does not.
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Google OAuth Client ID (for 1-click Google Identity sign-in)
GOOGLE_CLIENT_ID=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=25
# Total seconds for trying the main model + fallbacks (keep under Vercel's 60 s limit)
LLM_TOTAL_BUDGET_SECONDS=50
# OpenRouter models tried in order if LLM_MODEL fails / is rate-limited / returns an empty answer
LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Extra tokens for free "reasoning" models so they don't run out before writing the answer
LLM_REASONING_BUDGET=1500

# Database: SQLite locally; Postgres in production, e.g.
#   postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./gymbuddy.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Secret key that the n8n automation sends in the X-API-Key header
AUTOMATION_API_KEY=change-me

# Context management / retrieval
HISTORY_WINDOW=10
RETRIEVAL_TOP_K=5

# Google Places API (New) for "Healthy restaurants near you" (photo, rating, hours). Optional: OpenStreetMap is used when empty.
GOOGLE_PLACES_API_KEY=
