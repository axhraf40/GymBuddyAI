# Local dev: the Next.js server forwards /api/* to the FastAPI backend.
# Default is http://127.0.0.1:8000 locally; on Vercel set it to the deployed API.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Google sign-in (optional). The OAuth client must allow this site's origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
